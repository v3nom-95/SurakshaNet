# Copy this file to .env and fill in real values. Never commit .env to git.

# Algorand TestNet wallet mnemonic (25 words)
ALGORAND_MNEMONIC=word1 word2 word3 ... word25

# Google Gemini API key (optional, fallback)
# GEMINI_API_KEY=your_gemini_key_here

# Groq API key — free tier at https://console.groq.com/
# Free tier: 14,400 requests/day, no credit card needed
GROQ_API_KEY=your_groq_api_key_here

# ML tuning (optional — these are the defaults)
CONTAMINATION_RATE=0.10
ANOMALY_THRESHOLD=0.70
DATASET_SIZE=30000

# CORS — set to your Render frontend URL in production, e.g.:
# ALLOWED_ORIGINS=https://surakshanet-frontend.onrender.com
ALLOWED_ORIGINS=*
